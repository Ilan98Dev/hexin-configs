pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.config

// Keeps kitty / gtk colour files in sync with the active Theme palette.
Singleton {
    id: root

    property var preset: Theme.p
    property color accent: Theme.accent

    function toHex(c) {
        try {
            return "#" + ((Math.round(c.r * 255) << 16) | (Math.round(c.g * 255) << 8) | Math.round(c.b * 255)).toString(16).padStart(6, '0');
        } catch (e) {
            return "#000000";
        }
    }

    function apply() {
        if (!preset)
            return;

        const base = preset.base || "#121118";
        const surface = preset.surface || "#262335";
        const surfaceHi = preset.surfaceHi || "#332f45";
        const text = preset.text || "#F3F4F6";
        const red = preset.red || "#ef4444";
        const green = preset.green || "#22c55e";
        const yellow = preset.yellow || "#EAB308";
        const blue = preset.blue || "#7C3AED";
        const acc = (typeof accent === "object") ? toHex(accent) : String(accent || "#F97316");

        const kitty = [
            "cursor " + text,
            "cursor_text_color " + base,
            "",
            "foreground            " + text,
            "background            " + base,
            "selection_foreground  " + text,
            "selection_background  " + surfaceHi,
            "url_color             " + acc,
            "",
            "color0   " + base,
            "color1   " + red,
            "color2   " + green,
            "color3   " + yellow,
            "color4   " + blue,
            "color5   " + acc,
            "color6   " + acc,
            "color7   " + text,
            "color8   " + surfaceHi,
            "color9   " + red,
            "color10  " + green,
            "color11  " + yellow,
            "color12  " + blue,
            "color13  " + acc,
            "color14  " + acc,
            "color15  " + text
        ].join("\n") + "\n";

        kittyFile.path = Quickshell.env("HOME") + "/.config/kitty/hexin-theme.conf";
        kittyFile.setText(kitty);

        const gtk = "/* Generated by hexin GlobalTheme */\n\n@define-color accent_bg_color " + acc + ";\n@define-color accent_fg_color #000000;\n@define-color destructive_bg_color " + red + ";\n@define-color destructive_fg_color #000000;\n@define-color error_bg_color " + red + ";\n@define-color error_fg_color #000000;\n@define-color window_bg_color " + base + ";\n@define-color window_fg_color " + text + ";\n@define-color view_bg_color " + base + ";\n@define-color view_fg_color " + text + ";\n@define-color headerbar_bg_color " + base + ";\n@define-color headerbar_fg_color " + text + ";\n@define-color sidebar_bg_color " + (preset.mantle || surface) + ";\n@define-color sidebar_fg_color " + text + ";\n@define-color secondary_sidebar_bg_color " + (preset.mantle || surface) + ";\n@define-color secondary_sidebar_fg_color " + text + ";\n@define-color card_bg_color " + surface + ";\n@define-color card_fg_color " + text + ";\n@define-color popover_bg_color " + surface + ";\n@define-color popover_fg_color " + text + ";\n";

        gtk3File.path = Quickshell.env("HOME") + "/.config/gtk-3.0/hexin-colors.css";
        gtk3File.setText(gtk);
        gtk4File.path = Quickshell.env("HOME") + "/.config/gtk-4.0/hexin-colors.css";
        gtk4File.setText(gtk);

        gsettingsCmd.command = ["sh", "-c", "gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark 2>/dev/null; gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null"];
        gsettingsCmd.running = true;
    }

    FileView { id: kittyFile; watchChanges: false; printErrors: false }
    FileView { id: gtk3File; watchChanges: false; printErrors: false }
    FileView { id: gtk4File; watchChanges: false; printErrors: false }
    Process { id: gsettingsCmd; running: false }

    // Bindings so JsonAdapter / Theme updates always notify.
    readonly property string appearancePreset: Config.appearance.preset
    readonly property string appearanceAccent: Config.appearance.accent
    readonly property var matugenPal: Theme.matugen

    onAppearancePresetChanged: applyDebounce.restart()
    onAppearanceAccentChanged: applyDebounce.restart()
    onMatugenPalChanged: {
        if (Config.appearance.preset === "Auto (Matugen)")
            applyDebounce.restart();
    }

    Timer {
        id: applyDebounce
        interval: 80
        onTriggered: root.apply()
    }

    Component.onCompleted: applyDebounce.restart()
}
