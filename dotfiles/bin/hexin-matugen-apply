#!/bin/bash
set -e
WALL="$1"
[ -z "$WALL" ] && exit 0

# Strip file:// prefix if present and expand ~
WALL="${WALL#file://}"
WALL="${WALL/#\~/$HOME}"

[ ! -f "$WALL" ] && exit 0

matugen image "$WALL" --mode dark -t scheme-tonal-spot --source-color-index 0 -c "$HOME/.config/matugen/config.toml" >/dev/null 2>&1

COLORS="$HOME/.local/state/quickshell/user/generated/colors.json"
[ ! -f "$COLORS" ] && exit 0

python3 << 'PYTHON'
import json, os, subprocess, re

home = os.path.expanduser('~')
colors_path = os.path.join(home, '.local/state/quickshell/user/generated/colors.json')
try:
    c = json.load(open(colors_path))
except Exception:
    exit(0)

d = c.get('colors', {}).get('dark', {})
base = d.get('background', '#111318')
mantle = d.get('surface_container_low', d.get('surface', '#191c20')) or base
surface = d.get('surface_container', d.get('surface', '#1d2024')) or base
surfaceh = d.get('surface_container_high', '#282a2f')
text = d.get('on_background', d.get('on_surface', '#e2e2e9'))
accent = d.get('primary', '#a9c7ff')
red = d.get('error', '#ffb4ab')
green = d.get('tertiary', '#dcbce1')
yellow = d.get('tertiary', '#dcbce1')
blue = d.get('secondary', '#bdc7dc')
hex_clean = accent.lstrip('#')

# Write hexin-palette.json
pal = {
    "base": base,
    "mantle": mantle,
    "surface": surface,
    "surfaceHi": surfaceh,
    "text": text,
    "subtext": d.get('outline', '#8e9099'),
    "accent": accent,
    "red": red,
    "green": green,
    "yellow": yellow,
    "blue": blue,
}
try:
    open(os.path.join(home, '.local/state/quickshell/user/generated/hexin-palette.json'), 'w').write(json.dumps(pal, indent=2))
except Exception:
    pass

# Write kitty theme
kitty = f"""cursor {text}
cursor_text_color {base}

foreground            {text}
background            {base}
selection_foreground  {text}
selection_background  {surfaceh}
url_color             {accent}

color0   {base}
color1   {red}
color2   {green}
color3   {yellow}
color4   {blue}
color5   {accent}
color6   {accent}
color7   {text}
color8   {surfaceh}
color9   {red}
color10  {green}
color11  {yellow}
color12  {blue}
color13  {accent}
color14  {accent}
color15  {text}
"""
os.makedirs(os.path.join(home, '.config/kitty'), exist_ok=True)
open(os.path.join(home, '.config/kitty/hexin-theme.conf'), 'w').write(kitty)

# Write gtk CSS
gtk = f"""@define-color accent_bg_color {accent};
@define-color accent_fg_color {base};
@define-color destructive_bg_color {red};
@define-color destructive_fg_color {base};
@define-color error_bg_color {red};
@define-color error_fg_color {base};
@define-color window_bg_color {base};
@define-color window_fg_color {text};
@define-color view_bg_color {base};
@define-color view_fg_color {text};
@define-color headerbar_bg_color {base};
@define-color headerbar_fg_color {text};
@define-color sidebar_bg_color {surface};
@define-color sidebar_fg_color {text};
@define-color card_bg_color {surface};
@define-color card_fg_color {text};
@define-color popover_bg_color {surface};
@define-color popover_fg_color {text};
"""
os.makedirs(os.path.join(home, '.config/gtk-3.0'), exist_ok=True)
os.makedirs(os.path.join(home, '.config/gtk-4.0'), exist_ok=True)
open(os.path.join(home, '.config/gtk-3.0/hexin-colors.css'), 'w').write(gtk)
open(os.path.join(home, '.config/gtk-4.0/hexin-colors.css'), 'w').write(gtk)
subprocess.Popen(['gsettings', 'set', 'org.gnome.desktop.interface', 'gtk-theme', 'adw-gtk3-dark'], stderr=subprocess.DEVNULL)
subprocess.Popen(['gsettings', 'set', 'org.gnome.desktop.interface', 'color-scheme', 'prefer-dark'], stderr=subprocess.DEVNULL)

# Update Hyprland settings.lua so future reloads persist the active border
settings_path = os.path.join(home, '.config/hypr/hexin/settings.lua')
if os.path.exists(settings_path):
    try:
        content = open(settings_path).read()
        content = re.sub(r'\bactive_border\s*=\s*"[^"]*"', f'active_border = "rgba({hex_clean}ff)"', content)
        open(settings_path, 'w').write(content)
    except Exception:
        pass

# Apply to Hyprland immediately using hyprctl eval (works with Lua parser)
try:
    subprocess.run(['hyprctl', 'eval', f'hl.config({{ general = {{ col = {{ active_border = "rgba({hex_clean}ff)", inactive_border = "rgba(44464f77)" }} }} }})'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception:
    pass
PYTHON
