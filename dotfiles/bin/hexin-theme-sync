#!/bin/bash
# Sync kitty/gtk colours from the active hexin appearance preset.
set -euo pipefail
: "${HOME:?HOME is not set}"
CFG="$HOME/.config/hexin/settings.json"
COLORS="$HOME/.local/state/quickshell/user/generated/colors.json"
PALETTE="$HOME/.local/state/quickshell/user/generated/hexin-palette.json"

mapfile -t META < <(python3 - "$CFG" << 'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    a = d.get("appearance", {})
    preset = a.get("preset", "Hexin")
    if preset == "UnityOS":        # name used before the Hexin rename
        preset = "Hexin"
    print(preset)
    print(a.get("accent", "") or "")
except Exception:
    print("Hexin")
    print("")
PY
)
PRESET="${META[0]:-Hexin}"
ACCENT="${META[1]:-}"

load_matugen() {
  python3 - "$PALETTE" "$COLORS" << 'PY'
import json, os, sys
pal_path, colors_path = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(pal_path):
    try:
        data = json.load(open(pal_path))
    except Exception:
        data = {}
if not data.get("base") and os.path.isfile(colors_path):
    try:
        d = json.load(open(colors_path)).get("colors", {}).get("dark", {})
        data = {
            "base": d.get("background", "#131318"),
            "mantle": d.get("surface_container_low", d.get("surface", "#1b1b21")),
            "surface": d.get("surface_container", d.get("surface", "#1f1f25")),
            "surfaceHi": d.get("surface_container_high", "#29292f"),
            "text": d.get("on_background", d.get("on_surface", "#e4e1e9")),
            "accent": d.get("primary", "#bcc3ff"),
            "red": d.get("error", "#ffb4ab"),
            "green": d.get("tertiary", "#e6bad7"),
            "yellow": d.get("tertiary", "#e6bad7"),
            "blue": d.get("secondary", "#c4c5dd"),
        }
    except Exception:
        data = {}
defaults = {
    "base": "#121118", "mantle": "#1a1924", "surface": "#262335", "surfaceHi": "#332f45",
    "text": "#F3F4F6", "accent": "#F97316", "red": "#ef4444", "green": "#22c55e",
    "yellow": "#EAB308", "blue": "#7C3AED",
}
for k in defaults:
    print(data.get(k, defaults[k]))
PY
}

if [ "$PRESET" = "Auto (Matugen)" ]; then
  # Read the palette matugen already wrote. Generation is owned by
  # hexin-matugen-apply (triggered from GlobalTheme on wallpaper/preset).
  mapfile -t P < <(load_matugen)
  BASE="${P[0]}"; MANTLE="${P[1]}"; SURFACE="${P[2]}"; SURFACEHI="${P[3]}"
  TEXT="${P[4]}"; ACC="${P[5]}"; RED="${P[6]}"; GREEN="${P[7]}"; YELLOW="${P[8]}"; BLUE="${P[9]}"
elif [ "$PRESET" = "Catppuccin Mocha" ]; then
  BASE="#1e1e2e"; MANTLE="#181825"; SURFACE="#313244"; SURFACEHI="#45475a"; TEXT="#cdd6f4"; ACC="#cba6f7"; RED="#f38ba8"; GREEN="#a6e3a1"; YELLOW="#f9e2af"; BLUE="#89b4fa"
elif [ "$PRESET" = "Catppuccin Latte" ]; then
  BASE="#eff1f5"; MANTLE="#e6e9ef"; SURFACE="#ccd0da"; SURFACEHI="#bcc0cc"; TEXT="#4c4f69"; ACC="#8839ef"; RED="#d20f39"; GREEN="#40a02b"; YELLOW="#df8e1d"; BLUE="#1e66f5"
elif [ "$PRESET" = "Tokyo Night" ]; then
  BASE="#1a1b26"; MANTLE="#16161e"; SURFACE="#292e42"; SURFACEHI="#3b4261"; TEXT="#c0caf5"; ACC="#7aa2f7"; RED="#f7768e"; GREEN="#9ece6a"; YELLOW="#e0af68"; BLUE="#7dcfff"
elif [ "$PRESET" = "Gruvbox" ]; then
  BASE="#282828"; MANTLE="#1d2021"; SURFACE="#3c3836"; SURFACEHI="#504945"; TEXT="#ebdbb2"; ACC="#fe8019"; RED="#fb4934"; GREEN="#b8bb26"; YELLOW="#fabd2f"; BLUE="#83a598"
elif [ "$PRESET" = "Nord" ]; then
  BASE="#2e3440"; MANTLE="#272c36"; SURFACE="#3b4252"; SURFACEHI="#434c5e"; TEXT="#eceff4"; ACC="#88c0d0"; RED="#bf616a"; GREEN="#a3be8c"; YELLOW="#ebcb8b"; BLUE="#81a1c1"
elif [ "$PRESET" = "Rose Pine" ]; then
  BASE="#191724"; MANTLE="#16141f"; SURFACE="#26233a"; SURFACEHI="#403d52"; TEXT="#e0def4"; ACC="#c4a7e7"; RED="#eb6f92"; GREEN="#9ccfd8"; YELLOW="#f6c177"; BLUE="#31748f"
elif [ "$PRESET" = "Dracula" ]; then
  BASE="#282a36"; MANTLE="#21222c"; SURFACE="#343746"; SURFACEHI="#44475a"; TEXT="#f8f8f2"; ACC="#bd93f9"; RED="#ff5555"; GREEN="#50fa7b"; YELLOW="#f1fa8c"; BLUE="#8be9fd"
else
  BASE="#121118"; MANTLE="#1a1924"; SURFACE="#262335"; SURFACEHI="#332f45"; TEXT="#F3F4F6"; ACC="#F97316"; RED="#ef4444"; GREEN="#22c55e"; YELLOW="#EAB308"; BLUE="#7C3AED"
fi

[ -n "$ACCENT" ] && ACC="$ACCENT"

mkdir -p "$HOME/.config/kitty" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

{
  echo "cursor $TEXT"
  echo "cursor_text_color $BASE"
  echo ""
  echo "foreground            $TEXT"
  echo "background            $BASE"
  echo "selection_foreground  $TEXT"
  echo "selection_background  $SURFACEHI"
  echo "url_color             $ACC"
  echo ""
  echo "color0   $BASE"
  echo "color1   $RED"
  echo "color2   $GREEN"
  echo "color3   $YELLOW"
  echo "color4   $BLUE"
  echo "color5   $ACC"
  echo "color6   $ACC"
  echo "color7   $TEXT"
  echo "color8   $SURFACEHI"
  echo "color9   $RED"
  echo "color10  $GREEN"
  echo "color11  $YELLOW"
  echo "color12  $BLUE"
  echo "color13  $ACC"
  echo "color14  $ACC"
  echo "color15  $TEXT"
} > "$HOME/.config/kitty/hexin-theme.conf"

{
  echo "/* Generated by hexin-theme-sync */"
  echo ""
  echo "@define-color accent_bg_color $ACC;"
  echo "@define-color accent_fg_color #000000;"
  echo "@define-color destructive_bg_color $RED;"
  echo "@define-color destructive_fg_color #000000;"
  echo "@define-color error_bg_color $RED;"
  echo "@define-color error_fg_color #000000;"
  echo "@define-color window_bg_color $BASE;"
  echo "@define-color window_fg_color $TEXT;"
  echo "@define-color view_bg_color $BASE;"
  echo "@define-color view_fg_color $TEXT;"
  echo "@define-color headerbar_bg_color $BASE;"
  echo "@define-color headerbar_fg_color $TEXT;"
  echo "@define-color sidebar_bg_color $MANTLE;"
  echo "@define-color sidebar_fg_color $TEXT;"
  echo "@define-color card_bg_color $SURFACE;"
  echo "@define-color card_fg_color $TEXT;"
  echo "@define-color popover_bg_color $SURFACE;"
  echo "@define-color popover_fg_color $TEXT;"
} > "$HOME/.config/gtk-3.0/hexin-colors.css"
cp "$HOME/.config/gtk-3.0/hexin-colors.css" "$HOME/.config/gtk-4.0/hexin-colors.css"
gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark 2>/dev/null || true
gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true

HEX_CLEAN="${ACC#"#"}"
python3 -c "
import os, re
p = os.path.expanduser('~/.config/hypr/hexin/settings.lua')
if os.path.exists(p):
    c = open(p).read()
    c = re.sub(r'\bactive_border\s*=\s*\"[^\"]*\"', f'active_border = \"rgba(${HEX_CLEAN}ff)\"', c)
    open(p, 'w').write(c)
" 2>/dev/null || true
hyprctl eval "hl.config({ general = { col = { active_border = \"rgba(${HEX_CLEAN}ff)\", inactive_border = \"rgba(44464f77)\" } } })" 2>/dev/null || true
